{
  "name": "instcol",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Institutions Saint-Colomban — Gestion des inscriptions paroissiales (app statique + Supabase)",
  "scripts": {
    "dev": "vite",
    "build": "bun x tsc --noEmit && vite build",
