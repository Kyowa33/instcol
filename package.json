  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.5",
    "pgsql-parser": "^18.2.10",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
